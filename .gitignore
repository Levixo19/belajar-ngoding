# Artefak Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Artefak kompilasi dari contoh & latihan
*.class
*.o
*.out
*.exe
program

# Folder kerja latihan (kode jawaban user)
kerjaanku/

# Editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# Artefak dari contoh kode file-I/O di materi (dibuat saat contohnya dijalankan)
catatan.txt
data.json
# ... tetapi BUKAN kurikulum `data` di packages/konten: pola di atas pernah menyembunyikannya
# dan klon segar kehilangan satu dari 32 kurikulum (tes konten merah, 31 != 32).
!packages/konten/kurikulum/data.json
test.txt
besar.bin

# Laporan & cadangan progres
laporan-belajar.md
progres-belajar.json
*.json.bak

# Log pemasang pihak ketiga yang kebetulan jatuh di sini
install.log

# Tangkapan layar dan snapshot alat uji browser (Playwright MCP)
.playwright-mcp/

# Dependensi npm. Paket di packages/ memakai workspace npm; yang dipasang
# cuma perkakas (@types/node, lalu Vite/React di Tahap 1). Isi kurikulum dan
# seluruh algoritmanya tidak pernah bergantung pada satu paket pun -- aplikasi
# ini wajib utuh tanpa internet.
node_modules/

# Direktori kerja alat bantu agen. Bukan bagian aplikasi, dan isinya bisa
# memuat transkrip serta catatan sesi.
.agents/
.brud/
.claude/
.codex/

# Tangkapan layar sekali pakai
ringkasan.png

# Hasil bundel Vite. Yang dilayani `belajar-web.py` tetap webapp/statik/;
# bundel ini cuma dipakai untuk membuktikan port React bisa dibangun, dan
# isinya diturunkan sepenuhnya dari src/.
packages/web/dist/
